---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { categories } from "../data/categories";
import { sortArticlesByUpdatedDesc } from "../lib/articles";

const allArticles = sortArticlesByUpdatedDesc(await getCollection("articles"));
const featuredArticles = allArticles.filter((article) => article.data.display.featured).slice(0, 3);
const latestArticles = allArticles.slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">校友经验 · 大学生活 · 信息差桥梁</p>
        <h1>把大学里的真实生活，带回高中生看得见的地方。</h1>
        <p class="lead">
          霁湖行舟不只整理志愿填报经验，也收集专业学习、校园日常、衣食住行、城市体验和成长选择。分享不必写成长篇论文，一段具体经历、一个避坑提醒、一份生活观察，都能帮后来的人少一点陌生。
        </p>
        <div class="actions">
          <a class="button" href="/articles/">浏览文章</a>
          <a class="button secondary" href="/submit/">我要投稿</a>
        </div>
      </div>
      <aside class="hero-note">
        本站内容来自校友个人经历，适合用来理解真实处境和补足信息差。涉及招生政策、专业组、选科要求和录取位次，请以官方信息为准。
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>主要分类</h2>
          <p>先用稳定分类承接升学、专业和生活内容，后续通过标签和搜索扩展更细的发现路径。</p>
        </div>
      </div>
      <div class="grid">
        {
          categories.map((category) => (
            <a class="card" href={`/categories/${category.slug}/`}>
              <h3>{category.name}</h3>
              <p>{category.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>精选文章</h2>
          <p>优先露出对新读者最有帮助、最能补足信息差的真实分享。</p>
        </div>
        <a href="/articles/">查看全部</a>
      </div>
      <div class="article-list">
        {
          featuredArticles.length > 0
            ? featuredArticles.map((article) => <ArticleCard article={article} headingLevel="h3" />)
            : <p class="notice">暂未设置精选文章。</p>
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>最新更新</h2>
          <p>新的短分享、长经验和维护补充都会按更新时间展示。</p>
        </div>
      </div>
      <div class="article-list">
        {latestArticles.map((article) => <ArticleCard article={article} headingLevel="h3" />)}
      </div>
    </div>
  </section>
</BaseLayout>

