---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到">
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>页面未找到</h1>
      <p class="lead">这个地址暂时没有对应内容，可以返回首页或查看全部文章。</p>
      <div class="actions">
        <a class="button" href="/">返回首页</a>
        <a class="button secondary" href="/articles/">浏览文章</a>
      </div>
    </div>
  </header>
</BaseLayout>
