---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getArticleSlug, getAuthorLabel } from "../../lib/articles";
import ArticleInfo from "../../components/ArticleInfo.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: getArticleSlug(article) },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const author = article.data.author;
---

<BaseLayout title={article.data.title} description={article.data.description}>
  <article>
    <header class="article-header">
      <div class="narrow">
        <p class="eyebrow">{article.data.category}</p>
        <h1>{article.data.title}</h1>
        <p class="lead">{article.data.description}</p>
        <div class="meta">
          <span>发布于 {formatDate(article.data.date)}</span>
          <span>更新于 {formatDate(article.data.updated)}</span>
          <span>{getAuthorLabel(author)}</span>
        </div>
        <div class="chips" aria-label="文章标签">
          {article.data.tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>
      </div>
    </header>

    <div class="narrow">
      <ArticleInfo author={article.data.author} audience={article.data.audience} />

      <div class="prose">
        <Content />
      </div>

      {
        article.data.display.showDisclaimer && (
          <aside class="notice" style="margin-top: 20px;">
            本文为个人经验，仅供参考，不构成唯一报考建议。高校招生政策、专业组、选科要求和录取位次可能变化，请以官方信息为准。
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>
