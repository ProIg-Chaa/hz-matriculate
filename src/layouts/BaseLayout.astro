---
const {
  title = import.meta.env.PUBLIC_SITE_NAME || "霁湖行舟",
  description = import.meta.env.PUBLIC_SITE_DESCRIPTION ||
    "沉淀校友升学、专业与大学生活经验的静态资料库。",
  ogType = "website"
} = Astro.props;

const siteName = import.meta.env.PUBLIC_SITE_NAME || "霁湖行舟";
const pageUrl = Astro.url.href;
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const navItems = [
  { href: "/", label: "首页" },
  { href: "/articles/", label: "文章" },
  { href: "/questions/", label: "问答" },
  { href: "/search/", label: "搜索" },
  { href: "/submit/", label: "投稿" },
  { href: "/about/", label: "关于" }
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / 社交分享 -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary" />

    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="container header-inner">
          <a class="brand" href="/">{siteName}</a>
          <nav class="site-nav" aria-label="主导航">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  aria-current={
                    item.href === "/"
                      ? currentPath === item.href
                        ? "page"
                        : undefined
                      : currentPath.startsWith(item.href)
                        ? "page"
                        : undefined
                  }
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="container">
          <p>
            本站为校友自发维护的公益性信息整理项目，并非学校官方平台。内容仅供参考，请以官方招生信息为准。
          </p>
        </div>
      </footer>
    </div>
    <script>
      const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

      if (!motionQuery.matches && "IntersectionObserver" in window) {
        const revealTargets = document.querySelectorAll(
          ".hero, .section, .page-header, .article-header, .article-card, .card, .prose, .info-panel, .notice"
        );

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.14, rootMargin: "0px 0px -32px 0px" }
        );

        for (const target of revealTargets) {
          target.classList.add("reveal-target");
          observer.observe(target);
        }
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
