---
import type { Article } from "../lib/articles";
import { formatDate, getArticleUrl, getAuthorLabel, getSchoolMajor } from "../lib/articles";

interface Props {
  article: Article;
  headingLevel?: "h2" | "h3";
  featured?: boolean;
}

const { article, headingLevel = "h2", featured = false } = Astro.props;
const Heading = headingLevel;
const author = article.data.author;
const authorLabel = getAuthorLabel(author);
const schoolMajor = getSchoolMajor(author);
---

<article class:list={["article-card", { featured: featured }]}>
  <div class="meta">
    <span class="category-pill">{article.data.category}</span>
    <span>更新于 {formatDate(article.data.updated)}</span>
    <span>{authorLabel}</span>
    {schoolMajor && <span>{schoolMajor}</span>}
  </div>
  <Heading>
    <a href={getArticleUrl(article)}>{article.data.title}</a>
  </Heading>
  <p>{article.data.description}</p>
  <div class="chips" aria-label="文章标签">
    {article.data.tags.map((tag) => <span class="chip">{tag}</span>)}
  </div>
</article>
